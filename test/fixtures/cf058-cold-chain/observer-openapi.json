{
  "openapi": "3.1.0",
  "info": {
    "title": "CF-058 Fictional Cold-Chain Compliance Audit API",
    "version": "1.0.0",
    "description": "Separately approved read-side fixture material only. It grants no runtime authority and contains no credential values."
  },
  "servers": [
    {
      "url": "https://localhost:9444"
    }
  ],
  "paths": {
    "/v2/compliance-audit/quarantine-directives": {
      "get": {
        "operationId": "auditQuarantineDirective",
        "security": [{ "cf058ObserverBearer": [] }],
        "parameters": [
          {
            "name": "directive_ref",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Independent read-side compliance observation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["items", "server_time", "collateral_clean"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["directive_ref", "lot_code", "hold_quantity", "reason_confirmed", "status", "version", "updated_at"],
                        "properties": {
                          "directive_ref": { "type": "string" },
                          "lot_code": { "type": "string" },
                          "hold_quantity": { "type": "number" },
                          "reason_confirmed": { "type": "boolean" },
                          "status": { "type": "string", "const": "quarantined" },
                          "version": { "type": "integer", "minimum": 1 },
                          "updated_at": { "type": "string", "format": "date-time" }
                        }
                      }
                    },
                    "server_time": { "type": "string", "format": "date-time" },
                    "collateral_clean": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": { "description": "The separate observer credential is missing or invalid." },
          "500": { "description": "The independent audit surface is unavailable." }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cf058ObserverBearer": { "type": "http", "scheme": "bearer" }
    }
  }
}
