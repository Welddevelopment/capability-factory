{
  "openapi": "3.1.0",
  "info": { "title": "Zephyr Crate Dispatch", "version": "1.0.0" },
  "servers": [{ "url": "https://zephyr-crate.local.invalid/v2" }],
  "paths": {
    "/dispatches": {
      "post": {
        "operationId": "createCrateDispatch",
        "summary": "Create one bounded fictional crate dispatch",
        "security": [{ "zephyrDispatchWriter": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["dispatch_ref", "crate_code", "quantity"],
            "properties": {
              "dispatch_ref": { "type": "string" },
              "crate_code": { "type": "string" },
              "quantity": { "type": "integer" }
            }
          } } }
        },
        "responses": { "201": { "description": "Created" }, "409": { "description": "Conflict" } }
      },
      "get": {
        "operationId": "findCrateDispatches",
        "summary": "Observe dispatches by stable reference",
        "security": [{ "zephyrDispatchObserver": [] }],
        "parameters": [{ "name": "dispatch_ref", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Matches", "content": { "application/json": { "schema": {
          "type": "object",
          "properties": {
            "items": { "type": "array", "items": { "type": "object", "properties": {
              "dispatch_ref": { "type": "string" }, "crate_code": { "type": "string" }, "quantity": { "type": "integer" }
            } } },
            "server_time": { "type": "string", "format": "date-time" },
            "collateral_clean": { "type": "boolean" }
          }
        } } } } }
      }
    }
  },
  "components": { "securitySchemes": {
    "zephyrDispatchWriter": { "type": "http", "scheme": "bearer" },
    "zephyrDispatchObserver": { "type": "http", "scheme": "bearer" }
  } }
}
