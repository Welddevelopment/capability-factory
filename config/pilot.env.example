# Copy these names into a private local .env file. Never commit a real token.
CF_SIDECAR_TOKEN=replace-with-at-least-16-private-characters
# Separate customer-local signing authority; use at least 32 random bytes.
CF_CONTINUATION_AUTHORITY_SECRET=replace-with-a-separate-32-byte-or-longer-secret
CF_CONTINUATION_AUTHORITY_KEY_ID=local-pilot-continuation-v1
CF_SIDECAR_PORT=4321
CF_CONSOLE_PORT=4317
CF_PILOT_DATA=artifacts/pilot-runs/local-reference

# Optional: use these when Docker and its config live outside this checkout.
# CF_DOCKER_BIN=/absolute/path/to/docker
# CF_DOCKER_CONFIG=/absolute/path/to/docker-config
# CF_ERPNEXT_COMPOSE_DIR=/absolute/path/to/alternate/compose-directory

# Set to 1 only when you intentionally want to reset the fictional ERPNext batch.
CF_ERPNEXT_PILOT_RESET=0
